# Copier vers client/.env et renseigner la cle TMDB (https://www.themoviedb.org/settings/api)
VITE_TMDB_API_KEY=

# Identifiant d'application Google (client WEB, console Google Cloud).
# Facultatif : sans lui, la connexion Google est simplement masquee.
VITE_GOOGLE_CLIENT_ID=

# Firebase (projet des amis par code) - console Firebase > Parametres du projet > Vos applications.
# Valeurs publiques par nature : la protection vient de firebase/firestore.rules.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
