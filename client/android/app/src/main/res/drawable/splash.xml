<?xml version="1.0" encoding="utf-8"?>
<!-- Écran de démarrage : le fond sombre de l'application avec le logo au centre.
     Vectoriel et sans image : s'adapte à tous les écrans et toutes les
     orientations, là où le gabarit d'origine imposait une image par format. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/ic_launcher_background" />
    <item
        android:gravity="center"
        android:width="180dp"
        android:height="180dp"
        android:drawable="@drawable/ic_launcher_foreground" />
</layer-list>
